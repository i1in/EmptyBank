<Application x:Class="EmptyBank.XAML_App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:view="clr-namespace:EmptyBank.MVVM.View"
             xmlns:vms="clr-namespace:EmptyBank.MVVM.ViewModel"
             StartupUri="MVVM/View/MainWindow.xaml">
    <Application.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Страницы -->
                <ResourceDictionary Source="/Themes/MainWindowStyle.xaml" />
                <ResourceDictionary Source="/Themes/AuthViewStyle.xaml" />
                <ResourceDictionary Source="/Themes/SignViewStyle.xaml" />
                <ResourceDictionary Source="/Themes/BankWindowStyle.xaml" />
                <ResourceDictionary Source="/Themes/BankMainViewStyle.xaml" />
                <ResourceDictionary Source="/Themes/BankBillViewStyle.xaml" />
                <ResourceDictionary Source="/Themes/BankHistoryViewStyle.xaml" />
                <ResourceDictionary Source="/Themes/PersonalViewStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vms:AuthViewModel}">
                <view:AuthView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vms:SignViewModel}">
                <view:SignView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vms:BankMainViewModel}">
                <view:BankMainView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vms:BankBillViewModel}">
                <view:BankBillView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vms:BankHistoryViewModel}">
                <view:BankHistoryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vms:PersonalViewModel}">
                <view:PersonalView />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
