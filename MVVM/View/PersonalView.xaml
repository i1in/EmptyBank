<UserControl x:Class="EmptyBank.MVVM.View.PersonalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EmptyBank.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="420" d:DesignWidth="744">
    <Grid>
        <Border Style="{StaticResource PersonalBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="176"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Border Style="{StaticResource UserAvatar}">
                        <Canvas VerticalAlignment="Top" HorizontalAlignment="Center">
                            <Ellipse Width="36" Height="36" Canvas.Left="-18" Canvas.Top="-18" Fill="LightGray" Margin="0, 30, 0, 0"/>
                            <Ellipse Width="72" Height="43" Canvas.Left="-36" Canvas.Top="53" Fill="LightGray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Canvas>
                    </Border>
                    <TextBlock Text="{Binding UserLogin}"
                               Style="{StaticResource UserLogin}"/>
                    <TextBlock Text="ID: 150"
                               Style="{StaticResource UserID}"/>
                </Grid>
                <Grid Margin="0,163,0,0" Grid.RowSpan="2">
                    <Border Style="{StaticResource UserInteraction}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource UserPasswordBox}">
                                <Grid>
                                    <TextBlock Style="{StaticResource UserPasswordBoxTitle}"/>
                                    <Button VerticalAlignment="Top"
                                            HorizontalAlignment="Right"
                                            Height="24"
                                            Width="24"
                                            Content="↻"
                                            FontFamily="Roboto"
                                            FontSize="20"
                                            Background="#181818"
                                            Foreground="White"
                                            BorderThickness="0,0,0,0"
                                            Margin="0, 10, 5, 0"
                                            Command="{Binding RefreshData}"
                                            Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="10" />
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <TextBlock Style="{StaticResource UserPasswordBoxDescription}"
                                               Text="{Binding UserPasswordBoxDescription}"
                                               Foreground="{Binding UserPasswordBoxDescriptionColor}"/>
                                    <TextBox Style="{StaticResource UserPassword}"
                                             Text="{Binding UserPassword}"
                                             BorderBrush="{Binding UserPasswordBrush}"
                                             GotFocus="UserPasswordBoxGotFocus"
                                             LostFocus="UserPasswordBoxLostFocus"
                                             MaxLength="16"
                                             />
                                    <TextBox Name="FakePasswordBox"
                                        Style="{StaticResource FakeUserPasswordBox}"
                                        Text="Новый пароль"
                                        BorderBrush="{Binding NewPasswordBrush}"
                                        GotFocus="FakePasswordBox_GotFocus"
                                        LostFocus="FakePasswordBox_LostFocus"
                                        TextChanged="FakePasswordBox_TextChanged"
                                        MaxLength="16"/>

                                    <PasswordBox Name="UserPasswordBox"
                                        Style="{StaticResource RealUserPasswordBox}"
                                        BorderBrush="{Binding NewPasswordBrush}"
                                        PasswordChanged="UserPasswordChanged"
                                        LostFocus="UserPasswordBox_LostFocus"
                                        GotFocus="UserPasswordBox_GotFocus"
                                        MaxLength="16"/>
                                    <ToggleButton Name="ShowPassword"
                                        Style="{StaticResource ShowdHidePasswordBox}"
                                        Checked="ShowPassword_Checked"
                                        Unchecked="ShowPassword_Unchecked"/>
                                    <Button Style="{StaticResource ApproveButton}"
                                            Command="{Binding ApproveButton}"
                                            CommandParameter="{Binding ElementName=UserPasswordBox}">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5" />
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1"
                                    Style="{StaticResource UserSignOutBox}">
                                <Grid>
                                    <TextBlock Style="{StaticResource UserSignOutBoxTitle}"/>
                                    <Button Style="{StaticResource SignOutButton}"
                                            Click="Button_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5" />
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
