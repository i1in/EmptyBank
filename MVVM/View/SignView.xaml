<UserControl x:Class="EmptyBank.MVVM.View.SignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EmptyBank.MVVM.View" xmlns:viewmodel="clr-namespace:EmptyBank.MVVM.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:MainViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="470" d:DesignWidth="450"
             Background="#1c1c1c">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource SignTextBlock}" />
                <TextBlock Style="{StaticResource SignTextBlockMini}" />
            </StackPanel>
            <StackPanel Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Width="350">
                        <TextBlock Style="{StaticResource SignInTextBlock}"
                                   x:Name="SignInText"/>
                        <TextBox Style="{StaticResource SignInTextBox}" 
                                 x:Name="SignInBox"/>

                        <TextBlock Style="{StaticResource SignInTextBlockPassword}" 
                                   x:Name="SignInPasswordText"/>
                        <PasswordBox Style="{StaticResource SignInPasswordBox}" 
                                     x:Name="SignInPassBox"/>
                        <TextBlock Style="{StaticResource RepeatSignInTextBlockPassword}" 
                                   x:Name="SignInRepeatPassText"/>
                        <PasswordBox Style="{StaticResource RepeatSignInPasswordBox}" 
                                     x:Name="SignInRepeatPassBox"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Width="350">
                        <Button Style="{StaticResource SignInButton}"
                                Command="{Binding ShowAuthView}"
                                Click="RegisterButton"
                                x:Name="SignButton">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource IsSignedIn}"
                                       Grid.Column="0"/>
                            <Button Style="{StaticResource IsSignedInButton}"
                                    Grid.Column="1"
                                    Command="{Binding ShowAuthView}"
                                    x:Name="NavigateToAuth">
                                <Run Style="{StaticResource IsSignedInSpan}">
                                    Войти
                                </Run>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
        <ContentPresenter Content="{Binding CurrentView}"/>
    </Grid>
</UserControl>
