<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type TextBlock}" x:Key="BillViewTitle">
        <Setter Property="Text" Value="Перевод клиенту EmptyBank" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="25, 0, 0, 0" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="26" />
    </Style>

    <Style TargetType="{x:Type Border}" x:Key="BillCard">
        <Setter Property="Background" Value="#262626" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="25, 0, 0, 0" />
        <Setter Property="Height" Value="300" />
        <Setter Property="Width" Value="300" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="TransactionTitle">
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Text" Value="Выберите способ оплаты" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0, 15, 0, 0" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="21" />
    </Style>

    <Style TargetType="{x:Type Button}" x:Key="TransactionButtonCard">
        <Setter Property="Content" Value="Перевод по карте ›"/>
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Height" Value="70" />
        <Setter Property="Width" Value="250"/>
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0, 20, 0, 0" />
        <Setter Property="BorderThickness" Value="0,0,0,0" />
        <Setter Property="Background" Value="#181818" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#202020" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="CardOrNick">
        <Setter Property="Text" Value="ИЛИ" />
        <Setter Property="Grid.Row" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Margin" Value="0, 10, 0, 0" />
    </Style>

    <Style TargetType="{x:Type Button}" x:Key="TransactionCardNick">
        <Setter Property="Grid.Row" Value="3" />
        <Setter Property="Height" Value="70" />
        <Setter Property="Width" Value="250" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0, 10, 0, 0" />
        <Setter Property="BorderThickness" Value="0,0,0,0" />
        <Setter Property="Background" Value="#181818" />
        <Setter Property="Content" Value="Перевод по нику ›" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#202020" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Button}" x:Key="ButtonCardApprove">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#202020" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>