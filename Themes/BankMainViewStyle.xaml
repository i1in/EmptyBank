<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type TextBlock}" x:Key="Greetings">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Margin" Value="25, 30, 0, 0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style TargetType="{x:Type Button}" x:Key="RefreshData">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0, 0, 50, 0"/>
        <Setter Property="Height" Value="48" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Content" Value="↻" />
        <Setter Property="BorderThickness" Value="0,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0, -7, 0, 0" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="48" />
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                            Margin="0,-7,0,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#242424" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Border}" x:Key="UserCardBorder">
        <Setter Property="Height" Value="210" />
        <Setter Property="Width" Value="330" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0, 50, 0, 0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="#262626" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="BankLogo">
        <Setter Property="Text" Value="🔰"/>
        <Setter Property="Foreground" Value="LightGoldenrodYellow" />
        <Setter Property="FontSize" Value="29" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Margin" Value="5, 5, 0, 0" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="BankLogoText">
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="Margin" Value="2, 6, 0, 0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Roboto" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="WirelessLogo">
        <Setter Property="Text" Value="☁" />
        <Setter Property="Grid.Column" Value="2" />
        <Setter Property="Foreground" Value="LightGoldenrodYellow" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Margin" Value="0, 1, 5, 0" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="CardInternational">
        <Setter Property="Text" Value="🌐" />
        <Setter Property="FontSize" Value="38" />
        <Setter Property="Foreground" Value="LightGoldenrodYellow" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="20, 41, 250, 79" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="CardNumber">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Margin" Value="15, 0, 0, 20" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="CardBalance">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0, 0, 20, 20" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="CardCVC">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0, 0, 15, 20" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style TargetType="{x:Type Border}" x:Key="UserBonusBorder">
        <Setter Property="Height" Value="210" />
        <Setter Property="Width" Value="330" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0, 50, 0, 0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="#262626" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="CashbackText">
        <Setter Property="Text" Value="Кэшбэк и бонусы" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="15, 5, 0, 0" />
        <Setter Property="Grid.Column" Value="0" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="CashbackLogo">
        <Setter Property="Text" Value="🔹" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Margin" Value="0, 7, 5, 0" />
        <Setter Property="Foreground" Value="LightGoldenrodYellow" />
        <Setter Property="Grid.Column" Value="1" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="CashbackBalance">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Margin" Value="20, 0, 0, 20" />
        <Setter Property="Grid.Column" Value="0" />
    </Style>

    <Style TargetType="{x:Type Button}" x:Key="CashbackWhy">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0, 0, 0, 15" />
        <Setter Property="Height" Value="18" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Run}" x:Key="CashbackWhyText">
        <Setter Property="TextDecorations" Value="Underline"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
            </Trigger>

        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="CashbackCardLogo">
        <Setter Property="Text" Value="🌟" />
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0, 0, 20, 20" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="38" />
        <Setter Property="Foreground" Value="LightGoldenrodYellow" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="CashbackTitleText">
        <Setter Property="Text" Value="Получайте и тратьте кэшбэк с удовольствием!" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Margin" Value="8,9,8,0" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="CashbackInfoText">
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="LightGray"/>
        <Setter Property="Margin" Value="0, 13, 0, 13" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="CashbackTerm">
        <Setter Property="Text" Value="* - 3% от суммы переводов" />
        <Setter Property="Foreground" Value="Gray" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Margin" Value="8, 0, 0, 4" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style TargetType="{x:Type Button}" x:Key="HideModalTitle">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0, 0, 5, 5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="DarkRed" />
        <Setter Property="Content" Value="╳" />
        <Setter Property="BorderThickness" Value="0,0,0,0" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>