<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type TextBlock}" x:Key="ApplicationNameBank">
        <Setter Property="Text" Value="EmptyBank" />
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Roboto"/>
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="10,9,0,0"/>
    </Style>

    <Style TargetType="{x:Type RadioButton}" x:Key="MainView">
        <Setter Property="Background" Value="#212121" />
        <Setter Property="Margin" Value="4, 0, 4, 0" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Margin="4">

                        <TextBlock Text="🏦"
                                   Foreground="DarkGray"
                                   HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                   FontSize="24"
                                   x:Name="MainViewInner"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1c1c1c"/>
                            <Setter TargetName="MainViewInner" 
                                    Property="TextBlock.Foreground" 
                                    Value="White"/>
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="#1c1c1c"/>
                            <Setter TargetName="MainViewInner" 
                                    Property="TextBlock.Foreground" 
                                    Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="MainViewText">
        <Setter Property="Text" Value="Главная"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="Gray" />
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style TargetType="{x:Type ToolTip}" x:Key="MainViewTip">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#282828" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Width" Value="64" />
        <Setter Property="PlacementRectangle" Value="50, 10, 0, 0"/>
        <Setter Property="Placement" Value="Right"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="4">
                        <TextBlock Text="Главная"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

