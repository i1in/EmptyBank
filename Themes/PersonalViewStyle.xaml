<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type Border}" x:Key="PersonalBackground">
        <Setter Property="Background" Value="#202020"/>
        <Setter Property="Margin" Value="10, 10, 10, 10"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style TargetType="{x:Type Border}" x:Key="UserAvatar">
        <Setter Property="Background" Value="#181818" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0, 15, 0, 60" />
        <Setter Property="Height" Value="96" />
        <Setter Property="Width" Value="96" />
        <Setter Property="CornerRadius" Value="50"/>
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="UserLogin">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0, 80, 0, 0"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontFamily" Value="Roboto"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="UserID">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0, 120, 0, 0"/>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Foreground" Value="Gray" />
    </Style>

    <Style TargetType="{x:Type Border}" x:Key="UserInteraction">
        <Setter Property="Background" Value="#181818" />
        <Setter Property="Margin" Value="10, 10, 10, 10"/>
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style TargetType="{x:Type Border}" x:Key="UserPasswordBox">
        <Setter Property="Background" Value="#202020" />
        <Setter Property="Margin" Value="6, 6, 0, 6" />
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="UserPasswordBoxTitle">
        <Setter Property="Text" Value="Пароль" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontFamily" Value="Roboto"/>
        <Setter Property="Margin" Value="0, 10, 0, 0"/>
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="UserPasswordBoxDescription">
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="0, 40, 0, 0" />
    </Style>

    <Style TargetType="{x:Type TextBox}" x:Key="UserPassword">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Width" Value="195" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0, 0, 0, 0"/>
        <Setter Property="BorderThickness" Value="0, 0, 0, 1"/>
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="5, 0, 0, 0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CaretBrush" Value="White" />
    </Style>

    <Style TargetType="{x:Type TextBox}" x:Key="FakeUserPasswordBox">
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0, 0, 20, 50" />
        <Setter Property="Width" Value="175" />
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="5, 0, 0, 0" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="CaretBrush" Value="White" />
    </Style>

    <Style TargetType="{x:Type PasswordBox}" x:Key="RealUserPasswordBox">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0, 0, 20, 50" />
        <Setter Property="Width" Value="175" />
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="5, 0, 0, 0" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="CaretBrush" Value="White" />
    </Style>

    <Style TargetType="{x:Type ToggleButton}" x:Key="ShowdHidePasswordBox">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="178, 0, 0, 50" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Width" Value="24"/>
        <Setter Property="Content" Value="👁" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="BorderThickness" Value="0, 0, 0, 1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>


        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="LightGoldenrodYellow" />
            </Trigger>

            <Trigger Property="IsChecked" Value="False">
                <Setter Property="Content" Value="🙈" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="🙉" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Button}" x:Key="ApproveButton">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Width" Value="100" />
        <Setter Property="Height" Value="24" />
        <Setter Property="BorderThickness" Value="0,0,0,0" />
        <Setter Property="Content" Value="Изменить" />
        <Setter Property="Background" Value="#181818" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#242424" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Border}" x:Key="UserSignOutBox">
        <Setter Property="Background" Value="#202020" />
        <Setter Property="Margin" Value="6, 6, 6, 6" />
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="UserSignOutBoxTitle">
        <Setter Property="Text" Value="Выход из аккаунта" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontFamily" Value="Roboto"/>
        <Setter Property="Margin" Value="0, 40, 0, 0"/>
    </Style>

    <Style TargetType="{x:Type Button}" x:Key="SignOutButton">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,30,0,10" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Width" Value="170" />
        <Setter Property="Height" Value="48" />
        <Setter Property="BorderThickness" Value="0,0,0,0" />
        <Setter Property="Content" Value="Выйти" />
        <Setter Property="Background" Value="#4F0014" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#560319" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>