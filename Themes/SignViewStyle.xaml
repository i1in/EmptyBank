<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type TextBlock}" x:Key="SignTextBlock">
        <Setter Property="Text" Value="Регистрация" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Margin" Value="0, 40, 0, 0" />
        <Setter Property="FontFamily" Value="Roboto" />
    </Style>
    
    <Style TargetType="{x:Type TextBlock}" x:Key="SignTextBlockMini">
        <Setter Property="Text" Value="Создание учётной записи" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="#CFCFCF" />
        <Setter Property="FontFamily" Value="Roboto" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="SignInTextBlock">
        <Setter Property="Text" Value="Придумайте логин" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,30,0,13"/>
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontFamily" Value="Roboto" />
    </Style>

    <Style TargetType="{x:Type TextBox}" x:Key="SignInTextBox">
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0,0,36,0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="CaretBrush" Value="White" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Effect" >
            <Setter.Value>
                <DropShadowEffect BlurRadius="40" Color="White"/>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Effect" >
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="40" Color="Blue"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="SignInTextBlockPassword">
        <Setter Property="Text" Value="Придумайте пароль" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,30,0,13"/>
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontFamily" Value="Roboto" />
    </Style>

    <Style TargetType="{x:Type PasswordBox}" x:Key="SignInPasswordBox">
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0,0,36,0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="CaretBrush" Value="White" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Effect" >
            <Setter.Value>
                <DropShadowEffect BlurRadius="40" Color="White"/>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Effect" >
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="40" Color="Blue"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="RepeatSignInTextBlockPassword">
        <Setter Property="Text" Value="Повторите пароль" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,30,0,13"/>
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontFamily" Value="Roboto" />
    </Style>

    <Style TargetType="{x:Type PasswordBox}" x:Key="RepeatSignInPasswordBox">
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0,0,36,0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="CaretBrush" Value="White" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Effect" >
            <Setter.Value>
                <DropShadowEffect BlurRadius="40" Color="White"/>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Effect" >
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="40" Color="Blue"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style TargetType="{x:Type Button}" x:Key="SignInButton">
        <Setter Property="Content" Value="Зарегистрироваться" />
        <Setter Property="Height" Value="36" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="#313338" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Margin" Value="0, 23, 0, 0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Width" Value="210" />
        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#252525" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="IsSignedIn">
        <Setter Property="Text" Value="Уже зарегистрированы?" />
        <Setter Property="Foreground" Value="#cfcfcf" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="73, 10, 0, 0" />
    </Style>

    <Style TargetType="{x:Type Button}" x:Key="IsSignedInButton">
        <Setter Property="Content" Value="Sign In" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#cfcfcf" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Width" Value="50" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Run}" x:Key="IsSignedInSpan">
        <Setter Property="Foreground" Value="#6A5ACD" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>